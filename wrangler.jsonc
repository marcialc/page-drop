{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "page-drop",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths fall back to the React app...
    "not_found_handling": "single-page-application",
    // ...except these, which the Worker must handle. Without this, a browser
    // visiting /p/abc123 would be served index.html instead of the page.
    "run_worker_first": ["/api/*", "/p/*", "/mcp", "/mcp/*", "/.well-known/oauth*"]
  },

  "kv_namespaces": [
    {
      "binding": "SITES",
      "id": "09cfa97cd13e42d4904dded6fe1bd2d7"
    }
  ]

  // Optional — serve on your own domain instead of *.workers.dev:
  // "routes": [{ "pattern": "drop.yourdomain.com", "custom_domain": true }]
}
