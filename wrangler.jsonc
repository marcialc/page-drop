{
  "name": "pagedrop",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths fall back to the React app...
    "not_found_handling": "single-page-application",
    // ...except these, which the Worker must handle. Without this, a browser
    // visiting /p/abc123 would be served index.html instead of the page.
    "run_worker_first": ["/api/*", "/p/*"]
  },

  // Paste the id printed by: npx wrangler kv namespace create SITES
  "kv_namespaces": [
    {
      "binding": "SITES",
      "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE"
    }
  ]

  // Optional — serve on your own domain instead of *.workers.dev:
  // "routes": [{ "pattern": "drop.yourdomain.com", "custom_domain": true }]
}
